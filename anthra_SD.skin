<display id="channelInfo">
	<window x1="25" x2="695" y1="-195" y2="-154" bpp="8"/>
	<window x1="25" x2="695" y1="-153" y2="-48" bpp="8"/>
	<window x1="25" x2="695" y1="-47" y2="-24" bpp="8"/>
	
		<image x="25" y="-175"  path="images/progressChannel.png"/>
		<ellipse x1="23" x2="29" y1="-175" y2="-160" arc="-2" color="#0000000"/>
		<ellipse x1="690" x2="696" y1="-175" y2="-160"  arc="-1" color="#0000000"/>
		



<!--LOGOSLEFT-->		<progress  x1="50" x2="671" y1="-145" y2="-142" color="BarFill" current="{PresentProgress}"  total="{PresentDuration}"/>
<!--LOGOSLEFT-->		<text x1="47"  x2="175" y1="-171" y2="-151" color="TextButton" align="center" font="Osd">{ChannelNumber}</text>
<!--LOGOSLEFT-->		<text x1="185" x2="450" y1="-171" y2="-151" color="TextButton" font="Osd">{ChannelName}</text>
<!--LOGOSLEFT-->		<text x1="470" x2="674" y1="-171" y2="-151" color="TextButton" align="right" font="Osd">{DateTime:%a %d.%m.}   {DateTime:%H\:%M}</text>
<!--LOGOSLEFT-->		<rectangle x1="25" x2="694" y1="-138" y2="-50"  color="Background"/>
<!--LOGOSLEFT-->		<image x1="45" x2="175" y1="-133"  y2="-59" colors="128" condition="file('/var/lib/vdr/anthralogos/{ChannelName}.png')" path="/var/lib/vdr/anthralogos/{ChannelName}.png"/>
<!--LOGOSLEFT-->		<image x1="45" x2="175" y1="-133"  y2="-59" colors="128" condition="file('/var/lib/vdr/anthralogos/{ChannelID}.png')" path="/var/lib/vdr/anthralogos/{ChannelID}.png"/>
<!--LOGOSLEFT-->		<image x1="45" x2="175" y1="-133"  y2="-59" colors="128" condition="not(or(file('/var/lib/vdr/anthralogos/{ChannelName}.png'),file('/var/lib/vdr/anthralogos/{ChannelID}.png')))" path="images/logobg.png"/>
<!--LOGOSLEFT-->		<ellipse x1="45" x2="48" y1="-133" y2="-130"   arc="-2" color="Background"/>
<!--LOGOSLEFT-->		<ellipse x1="45" x2="48" y1="-62" y2="-59"   arc="-3" color="Background"/>
<!--LOGOSLEFT-->		<ellipse x1="172" x2="175" y1="-133" y2="-130"   arc="-1" color="Background"/>
<!--LOGOSLEFT-->		<ellipse x1="172" x2="175" y1="-62" y2="-59"   arc="-4" color="Background"/>
<!--LOGOSLEFT-->		<blink x1="185"  x2="245"  y1="-139" y2="-119" delay="3000" color="#00000000" font="Osd">{PresentStartDateTime:%H\:%M}</blink>		
<!--LOGOSLEFT-->		<text x1="185"  x2="245"  y1="-139" y2="-119" color="TextHigh" font="Osd">{PresentStartDateTime:%H\:%M}</text>
<!--LOGOSLEFT-NOMARQUEE-->		<text x1="250"  x2="580" y1="-139" y2="-119" color="TextHigh" font="Osd">{PresentTitle}</text>
<!--LOGOSLEFT-->		<text x1="590" x2="674" y1="-139" y2="-119" condition="{PresentRemaining}" color="TextHigh" align="right" font="Sml">{PresentRemaining:%m}/{PresentDuration:%m}</text>
<!--LOGOSLEFT-NOMARQUEE-->		<text x1="260"  x2="674" y1="-119"  y2="-99"  color="TextButton" align="left" font="Sml">{PresentShortText}</text>
<!--LOGOSLEFT-->		<text x1="185"  x2="245"  y1="-94"  y2="-74" color="TextHigh" font="Osd">{FollowingStartDateTime:%H\:%M}</text>
<!--LOGOSLEFT-NOMARQUEE-->		<text x1="250"  x2="580" y1="-94"  y2="-74" color="TextHigh" font="Osd">{FollowingTitle}</text>
<!--LOGOSLEFT-->		<text x1="590" x2="674" y1="-94"  y2="-74" condition="{FollowingDuration}" color="TextButton" align="right" font="Sml">{FollowingDuration:%m}</text>
<!--LOGOSLEFT-NOMARQUEE-->		<text x1="260"  x2="674" y1="-74"  y2="-54" color="TextButton" align="left" font="Sml">{FollowingShortText}</text>

<!--DIGIT_SIGNAL--> <image  x="25"  y="-50" colors="128" path="images/buttonsChannel.png"/>
<!--DIGIT_SIGNAL--> <text x1="45"  x2="112" y1="-46" y2="-35" color="TextHigh" align="center" font="VDRSymbols Sans:Book@11">STR: {FrontendSTR}%</text>
<!--DIGIT_SIGNAL--> <text x1="113" x2="180" y1="-46" y2="-35" color="TextHigh" align="center" font="VDRSymbols Sans:Book@11">SNR: {FrontendSNR}%</text>
<text  x1="347" x2="412" y1="-46" y2="-35" align="center" condition="{HasTeletext}" color="BarFill" font="VDRSymbols Sans:Book@11">VTX</text>
<text  x1="413" x2="477" y1="-46" y2="-35" align="center" condition="{HasDolby}" color="BarFill" font="VDRSymbols Sans:Book@11">DOLBY</text>
<text  x1="478" x2="542" y1="-46" y2="-35" align="center" condition="equal({AudioChannel},'stereo')" color="BarFill" font="VDRSymbols Sans:Book@11">STEREO</text>
<text  x1="543" x2="608" y1="-46" y2="-35" align="center" condition="{IsEncrypted}"  color="BarFill" font="VDRSymbols Sans:Book@11">CRYPT</text>
<blink x1="609" x2="675" y1="-46" y2="-35" align="center" delay="600" condition="{IsRecording}" color="BarFill" font="VDRSymbols Sans:Book@11">REC</blink>
<text x1="347" x2="412" y1="-46" y2="-35" align="center" condition="not({HasTeletext})" color="TextButton" font="VDRSymbols Sans:Book@11">VTX</text>
<text x1="413" x2="477" y1="-46" y2="-35" align="center" condition="not({HasDolby})" color="TextButton" font="VDRSymbols Sans:Book@11">DOLBY</text>
<text x1="478" x2="542" y1="-46" y2="-35" align="center" condition="not(equal({AudioChannel},'stereo'))" color="TextButton" font="VDRSymbols Sans:Book@11">STEREO</text>
<text x1="543" x2="608" y1="-46" y2="-35" align="center" condition="not({IsEncrypted})" color="BarFill" font="VDRSymbols Sans:Book@11">FTA</text>
<text x1="609" x2="675" y1="-46" y2="-35" align="center" condition="not({IsRecording})" color="TextButton" font="VDRSymbols Sans:Book@11">REC</text>
		
		<block condition="or({MessageInfo},{MessageStatus},{MessageWarning},{MessageError})">
			<image x="25"  y="-55" colors="64" path="images/messageBG.png"/>
			<text x1="25" x2="695" y1="-50" y2="-30" align="center" color="TextHigh"  font="Osd">{MessageInfo}</text>
			<text x1="25" x2="695" y1="-50" y2="-30" align="center" color="GreenHigh" font="Osd">{MessageStatus}</text>
			<text x1="25" x2="695" y1="-50" y2="-30" align="center" color="YellowHigh" font="Osd">{MessageWarning}</text>
			<text x1="25" x2="695" y1="-50" y2="-30" align="center" color="RedHigh"  font="Osd">{MessageError}</text> 
		</block>
</display>

<display id="menu" >
	<window x1="25" x2="695" y1="25" y2="-24" bpp="8"/>
		
		<image   x="25"  y="25" colors="64" path="images/top.png"/>
		<ellipse x1="24" x2="37" y1="24" y2="44"   arc="-2" color="#0000000"/>
		<ellipse x1="684" x2="696" y1="24" y2="44"   arc="-1" color="#0000000"/>
		<rectangle x1="25" x2="694" y1="65" y2="-65"  color="Background" />	

	<list  x1="25" x2="635" y1="65" y2="-81" condition="equal({MenuTitle:clean},'VDR')" >
		<item height="23"/>
		<image x="25"  y="11"   condition="{IsMenuCurrent}" colors="64" path="images/menuCurrent.png"/>
		<ellipse x1="24" x2="34" y1="6" y2="21"  condition="{IsMenuCurrent}" arc="-2" color="Background"/>
		<ellipse x1="24" x2="34" y1="25" y2="40"  condition="{IsMenuCurrent}" arc="-3" color="Background"/>
		<ellipse x1="315" x2="325" y1="6" y2="21"  condition="{IsMenuCurrent}" arc="-1" color="Background"/>
		<ellipse x1="315" x2="325" y1="25" y2="40"  condition="{IsMenuCurrent}" arc="-4" color="Background"/>
<!--NOMARQUEE-->	<text x1="35" x2="290" y1="12" y2="41" color="TextHigh" font="Osd">{MenuGroup}</text>
<!--NOMARQUEE-->	<text x1="35" x2="290" y1="12" y2="32" color="TextButton" font="Osd">{MenuItem}</text>
<!--NOMARQUEE-ACTIVE-->	<text x1="35" x2="290" y1="12" y2="32" condition="{IsMenuCurrent}" color="TextHigh" align="left" font="Osd">{MenuCurrent}</text>
	</list>
	
<!-- TIMER-INFO MAIN-MENU BEGIN-->
	<block condition="equal({MenuTitle:clean},'VDR')">
		<text x1="45" x2="209" y1="34" y2="62" align="left" color="TextButton"  font="Osd">{MenuTitle} - {VdrVersion}</text>
		<text x1="216" x2="480" y1="34" y2="62" align="center" color="TextButton"  font="Osd">{DiskUsage}</text>
		<text x1="480" x2="674" y1="34" y2="62"  color="TextButton" align="right" font="Osd">{DateTime:%a %d.%m.}   {DateTime:%H\:%M}</text>
		<block condition="and({CurrentEventsTitle1},not({CurrentEventsTitle2}))">
			<text x1="520" x2="685" y1="-184" y2="-164" color="TextButton" font="VDRSymbols Sans:Book@20">Timer:</text>
			
			<text x1="520" x2="685" y1="-159" y2="-143" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsTitle1}</text>
			<blink x1="520" x2="685" y1="-159" y2="-143" delay="1000" condition="{CurrentEventsIsRecording1}" color="RedLow" font="VDRSymbols Sans:Book@12">{CurrentEventsTitle1}</blink>
			<text x1="520" x2="685" y1="-141" y2="-125" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsStartDateTime1:%a %d.%m  %H\:%M}</text>		
			<text x1="520" x2="685" y1="-121" y2="-107" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsChannelName1}</text>
		</block>
		<block condition="and({CurrentEventsTitle1},{CurrentEventsTitle2},not({CurrentEventsTitle3}))">
			<text x1="520" x2="685" y1="-224" y2="-204" color="TextButton" font="VDRSymbols Sans:Book@20">Timer:</text>
			<text x1="520" x2="685" y1="-199" y2="-183" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsTitle1}</text>
			<blink x1="520" x2="685" y1="-199" y2="-183" delay="1000" condition="{CurrentEventsIsRecording1}" color="RedLow" font="VDRSymbols Sans:Book@12">{CurrentEventsTitle1}</blink>
			<text x1="520" x2="685" y1="-181" y2="-165" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsStartDateTime1:%a\ %d.%m\ \ %H\:%M}</text>
			<text x1="520" x2="685" y1="-163" y2="-147" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsChannelName1}</text>
			
			<text x1="520" x2="685" y1="-141" y2="-125" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsTitle2}</text>
			<blink x1="520" x2="685" y1="-141" y2="-125" delay="1000" condition="{CurrentEventsIsRecording2}" color="RedLow" font="VDRSymbols Sans:Book@12">{CurrentEventsTitle2}</blink>
			<text x1="520" x2="685" y1="-123" y2="-107" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsStartDateTime2:%a %d.%m  %H\:%M}</text>		
			<text x1="520" x2="685" y1="-105" y2="-89" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsChannelName2}</text>
		</block>	
		<block condition="and({CurrentEventsTitle1},{CurrentEventsTitle2},{CurrentEventsTitle3})">
			<text x1="520" x2="685" y1="-282" y2="-262" color="TextButton" font="VDRSymbols Sans:Book@20">Timer:</text>
			<text x1="520" x2="685" y1="-257" y2="-241" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsTitle1}</text>
			<blink x1="520" x2="685" y1="-257" y2="-241" delay="1000" condition="{CurrentEventsIsRecording1}" color="RedLow" font="VDRSymbols Sans:Book@12">{CurrentEventsTitle1}</blink>
			<text x1="520" x2="685" y1="-239" y2="-223" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsStartDateTime1:%a\ %d.%m\ \ %H\:%M}</text>
			<text x1="520" x2="685" y1="-221" y2="-205" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsChannelName1}</text>
			
			<text x1="520" x2="685" y1="-199" y2="-183" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsTitle2}</text>
			<blink x1="520" x2="685" y1="-199" y2="-183" delay="1000" condition="{CurrentEventsIsRecording1}" color="RedLow" font="VDRSymbols Sans:Book@12">{CurrentEventsTitle2}</blink>
			<text x1="520" x2="685" y1="-181" y2="-165" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsStartDateTime2:%a\ %d.%m\ \ %H\:%M}</text>
			<text x1="520" x2="685" y1="-163" y2="-147" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsChannelName2}</text>
			
			<text x1="520" x2="685" y1="-141" y2="-125" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsTitle3}</text>
			<blink x1="520" x2="685" y1="-141" y2="-125" delay="1000" condition="{CurrentEventsIsRecording2}" color="RedLow" font="VDRSymbols Sans:Book@12">{CurrentEventsTitle3}</blink>
			<text x1="520" x2="685" y1="-123" y2="-107" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsStartDateTime3:%a %d.%m  %H\:%M}</text>		
			<text x1="520" x2="685" y1="-105" y2="-89" color="TextButton" font="VDRSymbols Sans:Book@12">{CurrentEventsChannelName3}</text>
	
		</block>	
	</block>
<!-- TIMER-INFO MAIN-MENU END-->
		
<!--SUBMENU-BEGIN-->
	<block condition="not(equal({MenuTitle:clean},'VDR'))">
		<text x1="480" x2="674" y1="34" y2="62"  color="TextButton" align="right" font="Osd">{DateTime:%a %d.%m.}   {DateTime:%H\:%M}</text>
		<text x1="45" x2="450" y1="34" y2="62" condition="not(equal({MenuTitle:rest},trans('Recordings')))" align="left"  color="TextButton" font="Osd">{MenuTitle}</text>
		<block  condition="equal({MenuTitle:rest},trans('Recordings'))">
			<text x1="45" x2="215" y1="34" y2="62" align="left"  color="TextButton" font="Osd">{MenuTitle}</text>
			<text x1="216" x2="480" y1="34" y2="62"   align="center"  color="TextButton" font="Osd">{DiskUsage}</text>
		</block>
		
	</block>
	
	<list x1="25" x2="635" y1="65" y2="-81"  condition="not(equal({MenuTitle:clean},'VDR'))">
		<item height="23"/>
		<image x="25"  y="11"  colors="64" condition="{IsMenuCurrent}" path="images/menuCurrentLong.png"/>
		<ellipse x1="24" x2="34" y1="6" y2="21"  condition="{IsMenuCurrent}" arc="-2" color="Background"/>
		<ellipse x1="24" x2="34" y1="25" y2="40"  condition="{IsMenuCurrent}" arc="-3" color="Background"/>
		<ellipse x1="635" x2="645" y1="6" y2="21"  condition="{IsMenuCurrent}" arc="-1" color="Background"/>
		<ellipse x1="635" x2="645" y1="25" y2="40"  condition="{IsMenuCurrent}" arc="-4" color="Background"/>
<!--NOMARQUEE-->	<text x1="35" x2="635" y1="12" y2="32" color="TextButton" font="Osd">{MenuItem}</text>
<!--NOMARQUEE-->	<text x1="35" x2="635" y1="12" y2="41" color="TextHigh" font="Osd">{MenuGroup}</text>
<!--NOMARQUEE-ACTIVE-->	<text x1="35" x2="635" y1="12" y2="32" condition="{IsMenuCurrent}" color="TextHigh"  font="Osd">{MenuCurrent}</text>
	</list>
<!--SUBMENU-END-->
	
		<image x="25" y="-65" colors="128" path="images/buttonsBG.png"/>
		<image x="45" y="-65" condition="{ButtonRed}" colors="64" path="images/button.png"/>
		<rectangle x1="47"  x2="201" y1="-56" y2="-55" condition="{ButtonRed}" color="RedHigh"/>		
		<image x="202" y="-65" condition="{ButtonGreen}" colors="64" path="images/button.png"/>
		<rectangle x1="204" x2="358" y1="-56" y2="-55" condition="{ButtonGreen}" color="GreenHigh"/>				
		<image x="359" y="-65" condition="{ButtonYellow}" colors="64" path="images/button.png"/>
		<rectangle x1="361" x2="515" y1="-56" y2="-55" condition="{ButtonYellow}" color="YellowHigh"/>				
		<image x="516" y="-65" condition="{ButtonBlue}" colors="64" path="images/button.png"/>
		<rectangle x1="518" x2="672" y1="-56" y2="-55" condition="{ButtonBlue}" color="BlueHigh"/>
	
		<text x1="47"  x2="201" y1="-53"  y2="-35" color="TextButton" align="center" font="Osd">{ButtonRed}</text>
		<text x1="204" x2="358" y1="-53"  y2="-35" color="TextButton" align="center" font="Osd">{ButtonGreen}</text>
		<text x1="361" x2="515" y1="-53"  y2="-35" color="TextButton" align="center" font="Osd">{ButtonYellow}</text>
		<text x1="518" x2="672" y1="-53"  y2="-35" color="TextButton" align="center" font="Osd">{ButtonBlue}</text>

	<block condition="{MenuText}" >
		<scrolltext  x1="50" x2="658" y1="80" y2="-82" font="Osd" color="TextDescr" >{MenuText}</scrolltext>
		<scrollbar  x1="668" x2="670" y1="80" y2="-82" condition="or({CanScrollUp},{CanScrollDown})" color="TextHigh" bgColor="TextButton" />
	</block> 

	<block condition="or({PresentDescription},{PresentTitle},{RecordingName})">
		<block  condition="{RecordingName}">
			<text x1="50" x2="670" y1="74" y2="98" color="TextDescr" font="VDRSymbols Sans:Book@20">{RecordingTitle}</text>
			<text x1="50" x2="670" y1="103" y2="125" color="TextDescr" align="left" font="Osd">{RecordingDateTime:%a %d.%m.%Y}   {RecordingDateTime:%H\:%M} Uhr</text>
						
			<block  condition="{RecordingShortText}">
				<text x1="50" x2="670" y1="130" y2="155" color="TextDescr" font="Sml" >Kanal: {ChannelName}  |  {RecordingLength} min  |  Dateigroesse: {RecordingSize} MB | Geschnitten: {RecordingCuttedLength} min</text>
				<text x1="50" x2="670" y1="160" y2="180" color="TextDescr"  font="Osd">{RecordingShortText}</text>
				<scrolltext x1="50" x2="658" y1="185" y2="-86" color="TextDescr" font="Osd">{RecordingDescription} </scrolltext>
				<scrollbar x1="668" x2="670" y1="185" y2="-86" color="TextDescr" bgColor="BackgroundDark" condition="or({CanScrollUp},{CanScrollDown})"/>
			</block>
			<block  condition="not({RecordingShortText})">
				<text x1="50" x2="670" y1="130" y2="155" color="TextDescr" font="Sml" >Kanal: {ChannelName}  |  {RecordingLength} min  |  Dateigroesse: {RecordingSize} MB | Geschnitten: {RecordingCuttedLength} min</text>
				<scrolltext x1="50" x2="658" y1="160" y2="-86" color="TextDescr" font="Osd">{RecordingDescription}</scrolltext>
				<scrollbar x1="668" x2="670" y1="160" y2="-86" color="TextDescr" bgColor="BackgroundDark" condition="or({CanScrollUp},{CanScrollDown})"/>
			</block>
		</block>
		<block  condition="not({RecordingName})">
				<text x1="50" x2="670" y1="74" y2="98" color="TextDescr" font="VDRSymbols Sans:Book@20" >{PresentTitle}</text>
				<text x1="50" x2="670" y1="103" y2="125" color="TextDescr" font="Sml" align="left" condition="not({PresentVPSDateTime})">{PresentStartDateTime:%a %d.%m.%y  %H\:%M} - {PresentEndDateTime:%H\:%M} ({PresentDuration:%m} min)</text>
				<text x1="50" x2="670" y1="103" y2="125" color="TextDescr" font="Sml" align="left"  condition="{PresentVPSDateTime}">{PresentStartDateTime:%a %d.%m.%y  %H\:%M} - {PresentEndDateTime:%H\:%M} ({PresentDuration:%m} min) VPS: {PresentVPSDateTime:%H\:%M}</text>
				<text x1="50" x2="670" y1="130" y2="155" color="TextDescr" font="Osd">{PresentShortText}</text>			
			<scrolltext x1="50" x2="658" y1="160" y2="-86" color="TextDescr" font="Osd">{PresentDescription}</scrolltext>
			<scrollbar x1="668" x2="670" y1="160" y2="-86" color="TextDescr" bgColor="BackgroundDark" condition="or({CanScrollUp},{CanScrollDown})"/>			
		</block>
	</block>
	<block condition="or({MessageInfo},{MessageStatus},{MessageWarning},{MessageError})">
		<image x="25"  y="-90" colors="64" path="images/messageBG.png"/>	
		<text x1="25" x2="695" y1="-87" y2="-67" align="center" color="TextHigh"  font="Osd">{MessageInfo}</text>
		<text x1="25" x2="695" y1="-87" y2="-67" align="center" color="GreenHigh" font="Osd">{MessageStatus}</text>
		<text x1="25" x2="695" y1="-87" y2="-67" align="center" color="YellowHigh" font="Osd">{MessageWarning}</text>
		<text x1="25" x2="695" y1="-87" y2="-67" align="center" color="RedHigh"  font="Osd">{MessageError}</text> 
	</block>
</display>
<display id="replayInfo">
	<window x1="25" x2="695" y1="-170" y2="-29" bpp="8"/>
			
<!--Progress-Bar-BEGIN-->    
		<image x="25"  y="-119"  colors="256"  path="images/recbar.png"/>
		<ellipse x1="23" x2="29" y1="-119" y2="-104" arc="-2" color="#0000000"/>
		<ellipse x1="690" x2="696" y1="-119" y2="-104"  arc="-1" color="#0000000"/>
<!--NOMARQUEE-->		<text x1="35" x2="685" y1="-109" y2="-79" color="TextHigh" font="Osd">{ReplayTitle}</text>
		<text x1="35" x2="200" y1="-58" y2="-38" color="TextButton" align="left" font="Osd">{ReplayPosition}</text>
		<text x1="400" x2="685" y1="-58" y2="-38" color="TextButton" align="right" font="Osd">{ReplayDuration}</text>
		<progress x1="26" x2="694" y1="-82" y2="-67" color="BarFill" mark="Black" keep="Black"  current="{ReplayPositionIndex}"  total="{ReplayDurationIndex}"/>

<!--Progress-BAR-END-->	

		<text condition="{IsPlaying}" x1="360" x2="435" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">PLAY</text>
		<text condition="{IsPausing}" x1="284" x2="359" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">PAUSE</text>
		<text condition="{IsFastForward:0}" x1="512" x2="587" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.FWD</text>
		<text condition="{IsFastForward:1}" x1="512" x2="587" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.FWD 1x</text>
		<text condition="{IsFastForward:2}" x1="512" x2="587" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.FWD 2x</text>
		<text condition="{IsFastForward:3}" x1="512" x2="587" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.FWD 3x</text>
		<text condition="{IsFastRewind:0}" x1="132" x2="207" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.REW</text>
		<text condition="{IsFastRewind:1}" x1="132" x2="207" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.REW 1x</text>
		<text condition="{IsFastRewind:2}" x1="132" x2="207" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.REW 2x</text>
		<text condition="{IsFastRewind:3}" x1="132" x2="207" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.REW 3x</text>
		<text condition="{IsSlowForward:0}" x1="436" x2="511" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.FWD</text>		
		<text condition="{IsSlowForward:1}" x1="436" x2="511" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.FWD 1x</text>		
		<text condition="{IsSlowForward:2}" x1="436" x2="511" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.FWD 2x</text>		
		<text condition="{IsSlowForward:3}" x1="436" x2="511" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.FWD 3x</text>
		<text condition="{IsSlowRewind:0}" x1="208" x2="283" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.REW</text>	
		<text condition="{IsSlowRewind:1}" x1="208" x2="283" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.REW 1x</text>		
		<text condition="{IsSlowRewind:2}" x1="208" x2="283" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.REW 2x</text>		
		<text condition="{IsSlowRewind:3}" x1="208" x2="283" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.REW 3x</text>
			
		<text condition="not({IsPlaying})" x1="360" x2="435" y1="-55" y2="-40" align="center" color="DarkGrey" font="VDRSymbols Sans:Book@14">PLAY</text>
		<text condition="not({IsPausing})" x1="284" x2="359" y1="-55" y2="-40" align="center" color="DarkGrey" font="VDRSymbols Sans:Book@14">PAUSE</text>
		<text condition="not({IsFastForward})" x1="512" x2="587" y1="-55" y2="-40" align="center" color="DarkGrey" font="VDRSymbols Sans:Book@14">F.FWD   </text>
		<text condition="not({IsFastRewind})" x1="132" x2="207" y1="-55" y2="-40" align="center" color="DarkGrey" font="VDRSymbols Sans:Book@14">F.REW   </text>
		<text condition="not({IsSlowForward})" x1="436" x2="511" y1="-55" y2="-40" align="center" color="DarkGrey" font="VDRSymbols Sans:Book@14">S.FWD   </text>		
		<text condition="not({IsSlowRewind})" x1="208" x2="283" y1="-55" y2="-40" align="center" color="DarkGrey" font="VDRSymbols Sans:Book@14">S.REW   </text>		
		
		<rectangle x1="230" x2="485" y1="-170" y2="-130" color="#0000000"/>
		<image x="235" y="-170" condition="{ReplayPrompt}" path="images/jump.png"/>	
		<text x1="240" x2="480" y1="-160" y2="-140" align="center" color="TextHigh" font="Osd">{ReplayPrompt}</text>	
			
		<block condition="or({MessageInfo},{MessageStatus},{MessageWarning},{MessageError})">
			<image x="25"  y="-68" colors="64" path="images/messageBG.png"/>
			<text x1="25" x2="695" y1="-64" y2="-44" align="center" color="TextHigh"  font="Osd">{MessageInfo}</text>
			<text x1="25" x2="695" y1="-64" y2="-44" align="center" color="GreenHigh" font="Osd">{MessageStatus}</text>
			<text x1="25" x2="695" y1="-64" y2="-44" align="center" color="YellowHigh" font="Osd">{MessageWarning}</text>
			<text x1="25" x2="695" y1="-64" y2="-44" align="center" color="RedHigh"  font="Osd">{MessageError}</text> 
		</block>	
</display>
<display id="replaySmall">

	<window x1="120" x2="600" y1="-72" y2="-35" bpp="8"/>
	
		<image x="128"  y="-62"  colors="256"  path="images/recbarSmall.png"/>
		
		<text condition="{IsPlaying}" x1="360" x2="435" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">PLAY</text>
		<text condition="{IsPausing}" x1="284" x2="359" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">PAUSE</text>
		<text condition="{IsFastForward:0}" x1="512" x2="587" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.FWD</text>
		<text condition="{IsFastForward:1}" x1="512" x2="587" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.FWD 1x</text>
		<text condition="{IsFastForward:2}" x1="512" x2="587" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.FWD 2x</text>
		<text condition="{IsFastForward:3}" x1="512" x2="587" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.FWD 3x</text>
		<text condition="{IsFastRewind:0}" x1="132" x2="207" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.REW</text>
		<text condition="{IsFastRewind:1}" x1="132" x2="207" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.REW 1x</text>
		<text condition="{IsFastRewind:2}" x1="132" x2="207" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.REW 2x</text>
		<text condition="{IsFastRewind:3}" x1="132" x2="207" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">F.REW 3x</text>
		<text condition="{IsSlowForward:0}" x1="436" x2="511" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.FWD</text>		
		<text condition="{IsSlowForward:1}" x1="436" x2="511" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.FWD 1x</text>		
		<text condition="{IsSlowForward:2}" x1="436" x2="511" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.FWD 2x</text>		
		<text condition="{IsSlowForward:3}" x1="436" x2="511" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.FWD 3x</text>
		<text condition="{IsSlowRewind:0}" x1="208" x2="283" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.REW</text>	
		<text condition="{IsSlowRewind:1}" x1="208" x2="283" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.REW 1x</text>		
		<text condition="{IsSlowRewind:2}" x1="208" x2="283" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.REW 2x</text>		
		<text condition="{IsSlowRewind:3}" x1="208" x2="283" y1="-55" y2="-40" align="center" color="BarFill" font="VDRSymbols Sans:Book@14">S.REW 3x</text>
			
		<text condition="not({IsPlaying})" x1="360" x2="435" y1="-55" y2="-40" align="center" color="DarkGrey" font="VDRSymbols Sans:Book@14">PLAY</text>
		<text condition="not({IsPausing})" x1="284" x2="359" y1="-55" y2="-40" align="center" color="DarkGrey" font="VDRSymbols Sans:Book@14">PAUSE</text>
		<text condition="not({IsFastForward})" x1="512" x2="587" y1="-55" y2="-40" align="center" color="DarkGrey" font="VDRSymbols Sans:Book@14">F.FWD   </text>
		<text condition="not({IsFastRewind})" x1="132" x2="207" y1="-55" y2="-40" align="center" color="DarkGrey" font="VDRSymbols Sans:Book@14">F.REW   </text>
		<text condition="not({IsSlowForward})" x1="436" x2="511" y1="-55" y2="-40" align="center" color="DarkGrey" font="VDRSymbols Sans:Book@14">S.FWD   </text>		
		<text condition="not({IsSlowRewind})" x1="208" x2="283" y1="-55" y2="-40" align="center" color="DarkGrey" font="VDRSymbols Sans:Book@14">S.REW   </text>

</display>
<display id="volume">
	<window x1="25" x2="695" y1="-96" y2="-6" bpp="8"/>
		<image x="25" y="-89"  path="images/volume.png" />
		<ellipse x1="23" x2="29" y1="-89" y2="-74" arc="-2" color="#0000000"/>
		<ellipse x1="690" x2="696" y1="-89" y2="-74"  arc="-1" color="#0000000"/>
		<ellipse x1="23" x2="29" y1="-41" y2="-29" arc="-3" color="#0000000"/>
		<ellipse x1="690" x2="696" y1="-41" y2="-29"  arc="-4" color="#0000000"/>
		<!-- trans('Volume') -->
		<text x1="25" x2="365" y1="-84" y2="-68" align="right" color="TextHigh" condition="not({IsMute})" font="VDRSymbols Sans:Book@16">Volume</text>
		<text x1="366" x2="695" y1="-84" y2="-68" align="left" color="TextHigh" condition="not({IsMute})" font="VDRSymbols Sans:Book@16">: {VolumeCurrent}</text>
		<!--trans('Mute') -->
		<text x1="25" x2="695" y1="-84" y2="-68" align="center" color="TextHigh" condition="{IsMute}" font="VDRSymbols Sans:Book@16">Mute</text>
		<progress x1="27" x2="693" y1="-62" y2="-57" color="BarFill" current="{VolumeCurrent}" total="{VolumeTotal}"/>
		<rectangle x1="27" x2="693" y1="-62" y2="-57" condition="{IsMute}" color="BarBlock" />
</display>
<display id="audioTracks">
	<window x1="25" x2="695" y1="-132" y2="-27" bpp="8"/>
		<list x1="385" x2="695" y1="-132" y2="-27">
			<item height="33"/>
			<ellipse x1="10" x2="26" y1="3" y2="30"   arc="0" color="Background"/>
			<rectangle x1="18" x2="310" y1="3" y2="30"  color="Background" />
			<image x="10"  y="3" condition="{IsMenuCurrent}"  path="images/audio.png" />
			<ellipse x1="10" x2="18" y1="3" y2="17"  condition="{IsMenuCurrent}" arc="-2" color="#0000000"/>
			<ellipse x1="10" x2="18" y1="17" y2="31"  condition="{IsMenuCurrent}" arc="-3" color="#0000000"/>
			<text x1="40" x2="100" y1="5" y2="25" condition="{MenuCurrent}" color="TextHigh" font="Osd" align="left"> {MenuTitle}:</text>
			<text x1="120" x2="300" y1="5" y2="25" color="TextButton" font="Osd" align="right">{MenuItem}</text>
			<text x1="120" x2="300" y1="5" y2="25" color="BarFill" font="Osd" align="left"> {MenuCurrent}</text>
		</list>
</display>
<display id="message">
	<window x1="25" x2="695" y1="-55" y2="-25" bpp="8"/>
    
		<block condition="or({MessageInfo},{MessageStatus},{MessageWarning},{MessageError})">
			
			<image x="25"  y="-55" colors="64" path="images/messageBG.png"/>		
	
			<text x1="25" x2="695" y1="-53" y2="-33" align="center" color="TextHigh"  font="Osd">{MessageInfo}</text>
			<text x1="25" x2="695" y1="-53" y2="-33" align="center" color="GreenHigh" font="Osd">{MessageStatus}</text>
			<text x1="25" x2="695" y1="-53" y2="-33" align="center" color="YellowHigh" font="Osd">{MessageWarning}</text>
			<text x1="25" x2="695" y1="-53" y2="-33" align="center" color="RedHigh"  font="Osd">{MessageError}</text> 
		</block>
</display>
</skin>
